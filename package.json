{
  "name": "hasegawa",
  "version": "0.0.1",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/language-server": "2.17.2",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.3.8",
    "markdown-it": "15.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "sanitize-html": "2.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run check:types && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check ./src && prettier --check \"src/**/*.astro\"",
    "check:types": "astro check && tsc --noEmit --project tsconfig.json",
    "check:native": "astro sync && tsc --noEmit --project tsconfig.json",
    "check:fix": "biome check --write ./src && prettier --write \"src/**/*.astro\"",
    "format": "biome format --write ./src && prettier --write \"src/**/*.astro\"",
    "format:astro": "prettier --write \"src/**/*.astro\""
  },
  "type": "module"
}
